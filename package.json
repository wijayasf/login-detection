{
  "name": "detection-anomaly-rbac-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "NEXT_PUBLIC_BASE_PATH=/login-detection next build",
    "serve:export": "node scripts/serve-export.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/browser-smoke.mjs",
    "smoke:pages": "PROTOTYPE_URL=http://127.0.0.1:3002/login-detection SMOKE_OUTPUT_DIR=evidence/pages-local-screenshots node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "22.12.0",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "jsdom": "^25.0.1",
    "typescript": "5.7.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
